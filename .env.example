# ============================================================
# CodeNova 智码星 —— 环境变量配置模板
# 复制为 .env 并按需修改
# ============================================================

# ---------- 应用通用 ----------
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000
# 浏览器访问后端的主机名（开发环境 localhost，生产环境改为对外域名）
BACKEND_EXTERNAL_HOST=localhost
LOG_LEVEL=INFO

# ---------- 安全 ----------
# API Key 鉴权（生产环境必填，留空则不启用鉴权）
# 生成方法: python -c "import secrets; print(secrets.token_urlsafe(32))"
CODENOVA_API_KEY=
# CORS 允许来源（逗号分隔，生产环境需填写前端域名）
# 示例: https://codenova-frontend.onrender.com,https://your-custom-domain.com
CORS_ALLOWED_ORIGINS=
# Demo 模式最大文件数限制（防止 OOM，0 表示不限制，生产环境建议设为 150-300）
DEMO_MAX_FILES=0

# ---------- PostgreSQL ----------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=codenova
POSTGRES_PASSWORD=your_password_here
POSTGRES_DB=codenova
POSTGRES_DSN=postgresql+psycopg://codenova:your_password_here@postgres:5432/codenova

# ---------- Redis（Celery Broker / 缓存） ----------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# ---------- Qdrant 向量数据库 ----------
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=
QDRANT_COLLECTION_CODE=codenova_code_chunks
QDRANT_COLLECTION_DOCS=codenova_docs
QDRANT_VECTOR_SIZE=1024

# ---------- MinIO 对象存储 ----------
MINIO_HOST=minio
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=your_minio_password_here
MINIO_SECURE=false
MINIO_BUCKET_REPOS=codenova-repos
MINIO_BUCKET_DOCS=codenova-docs

# ---------- GitHub 拉取 ----------
GITHUB_TOKEN=
GITHUB_CLONE_BASE_DIR=/tmp/codenova_repos

# ---------- LLM / Embedding ----------
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
EMBEDDING_MODEL=BAAI/bge-m3
LLM_MODEL=gpt-4o

# ---------- 前端 ----------
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_WS_BASE_URL=ws://localhost:8000/ws
